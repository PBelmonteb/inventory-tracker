# Copia este archivo a .env.local y llena los valores de tu proyecto Supabase.
# (Supabase Dashboard -> Project Settings -> API)

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Solo servidor — nunca con prefijo NEXT_PUBLIC_, nunca en el cliente, nunca en el repo.
# (Supabase Dashboard -> Project Settings -> API -> service_role key)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Secreto compartido con el Email Worker de Cloudflare.
# Generar con: openssl rand -hex 32
EMAIL_WEBHOOK_SECRET=genera-con-openssl-rand-hex-32

# Secreto del cron de reposición automática (pg_cron -> pg_net ->
# /api/generar-casos-automaticos). Generar igual: openssl rand -hex 32
# Ver el comentario final de supabase/migrations/0017_reposicion_automatica.sql
# para agendar el cron en Supabase una vez que esta variable esté configurada.
AUTO_CASOS_SECRET=genera-con-openssl-rand-hex-32

# Opcional — envío automático de órdenes de compra por convenio (ver
# lib/email.ts). Sin esto, la reposición automática simplemente deja el
# caso en "pendiente" con una nota, en vez de mandar el correo real.
# Requiere un dominio propio verificado en Resend (resend.com/domains) con
# SPF/DKIM configurados — sin eso, Resend rechaza o el correo cae en spam.
RESEND_API_KEY=
EMAIL_FROM=compras@tu-dominio.com

# Opcional — sin esto, Sentry simplemente no se activa (ver lib/config.ts).
# Crear proyecto gratis en sentry.io -> Settings -> Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=

# Opcional — solo para subir source maps en el build (traduce errores
# minificados de producción a tu código real). Sentry Dashboard -> Settings
# -> Auth Tokens. Sin esto, el build corre igual, solo sin esa traducción.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
